# demo runs without an API key and never contacts Mirai or dials a phone.
MIRAI_MODE=demo
# To use your workspace, set MIRAI_MODE=live and add your key below.
MIRAI_API_KEY=
MIRAI_BASE_URL=https://sandbox.voice.miraiminds.co
PORT=3000
# Optional sample order service, kept separate from the editor on port 3001.
TOOL_SHARED_SECRET=
