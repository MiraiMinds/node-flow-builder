{
  "name": "@miraiminds/node-flow-builder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js --production",
    "test": "node --test test/*.test.js",
    "check": "npm test && npm run build && npm run test:ui",
    "tools": "node --env-file-if-exists=.env server/start-tools.js",
    "test:ui": "node test/ui.smoke.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.9.0",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "vite": "^7.1.7"
  }
}
